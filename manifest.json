{
  "manifest_version": 2,
  "name": "VK Music Saver",
  "version": "1.1.1",
  "description": "Добавляет кнопку скачивания треков в VK рядом с элементами плеера и треков. Поддерживает выбор качества, формата и скрытие лишних кнопок.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vk-music-saver@vkms.addon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "downloads",
    "webRequest",
    "storage",
    "https://*/*"
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    },
    "default_title": "VK Music Saver — Настройки",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/popup.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "src/settings.js",
      "src/mp3-tagger.js",
      "src/ts-demuxer.js",
      "src/m4a-muxer.js",
      "src/hls-downloader.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vk.com/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.vk.com/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "src/settings.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
